generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ═══ User Management ═══
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("user")
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  profile      UserProfile?
  goal         UserGoal?
  allergies    UserAllergy[]
  preference   UserPreference?
  foodLogs     FoodLog[]
  dailyNutritions DailyNutrition[]
  waterLogs    WaterLog[]
  weightLogs   WeightLog[]
  mealPlanDays MealPlanDay[]
  unknownFoodSubmissions UnknownFoodSubmission[]
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String?
  lastName  String?
  age       Int?
  gender    String?
  heightCm  Float?
  weightKg  Float?
  country   String?
  timezone  String   @default("UTC")
  avatarUrl String?
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserGoal {
  id               String   @id @default(cuid())
  userId           String   @unique
  goalType         String
  activityLevel    String
  workoutFrequency String?
  targetWeightKg   Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserAllergy {
  id          String   @id @default(cuid())
  userId      String
  allergyName String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  cuisinePreference String?
  dietType         String?
  budgetLevel      String?
  macroOverrideJson String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══ Food Database ═══
model Ingredient {
  id                   String   @id @default(cuid())
  name                 String   @unique
  isVeg                Boolean  @default(true)
  isVegan              Boolean  @default(true)
  containsAllergen     Boolean  @default(false)
  caloriesPer100g      Float
  proteinPer100g       Float
  carbsPer100g         Float
  fatPer100g           Float
  fiberPer100g         Float?
  sugarPer100g         Float?
  sodiumMgPer100g      Float?
  calciumMgPer100g     Float?
  ironMgPer100g        Float?
  zincMgPer100g        Float?
  magnesiumMgPer100g   Float?
  cholesterolMgPer100g Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  mealIngredients      MealIngredient[]
}

model Meal {
  id              String          @id @default(cuid())
  name            String
  description     String?
  mealType        String
  cuisine         String
  isVeg           Boolean         @default(false)
  isVegan         Boolean         @default(false)
  isEggetarian    Boolean         @default(false)
  baseServingGms  Int             @default(100)
  prepTimeMin     Int?
  imageUrl        String?
  isActive        Boolean         @default(true)
  source          String          @default("admin")
  externalId      String?
  imageSearchName String?
  nutritionStatus String          @default("verified")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  nutrition      MealNutrition?
  servings       MealServing[]
  aliases        MealAlias[]
  tags           MealTag[]
  ingredients    MealIngredient[]
  logItems       FoodLogItem[]
  planItems      MealPlanItem[]
}

model MealNutrition {
  id            String   @id @default(cuid())
  mealId        String   @unique
  calories      Float
  proteinG      Float
  carbsG        Float
  fatG          Float
  fiberG        Float?
  sugarG        Float?
  sodiumMg      Float?
  calciumMg     Float?
  ironMg        Float?
  zincMg        Float?
  magnesiumMg   Float?
  cholesterolMg Float?
  perServingGms Int      @default(100)
  createdAt     DateTime @default(now())
  meal          Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
}

model MealServing {
  id          String   @id @default(cuid())
  mealId      String
  servingName String
  servingGms  Int
  multiplier  Float
  createdAt   DateTime @default(now())
  meal        Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
}

model MealAlias {
  id        String   @id @default(cuid())
  mealId    String
  aliasName String
  createdAt DateTime @default(now())
  meal      Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
}

model MealTag {
  id      String   @id @default(cuid())
  mealId  String
  tagName String
  meal    Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
}

model MealIngredient {
  id              String      @id @default(cuid())
  mealId          String
  ingredientName  String
  containsAllergen Boolean     @default(false)
  amountGrams     Float?
  ingredientId    String?
  meal            Meal        @relation(fields: [mealId], references: [id], onDelete: Cascade)
  ingredient      Ingredient? @relation(fields: [ingredientId], references: [id])
}

// ═══ Daily Tracking ═══
model FoodLog {
  id               String   @id @default(cuid())
  userId           String
  logDate          String
  totalCalories    Float?
  totalProtein     Float?
  totalCarbs       Float?
  totalFat         Float?
  totalFiber       Float   @default(0)
  totalCalciumMg   Float   @default(0)
  totalIronMg      Float   @default(0)
  totalZincMg      Float   @default(0)
  totalMagnesiumMg Float   @default(0)
  totalCholesterolMg Float @default(0)
  status           String   @default("active")
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            FoodLogItem[]
  @@unique([userId, logDate])
}

model FoodLogItem {
  id            String   @id @default(cuid())
  foodLogId     String
  mealId        String?
  name          String?
  servingGms    Int
  calories      Float
  proteinG      Float
  carbsG        Float
  fatG          Float
  fiberG        Float   @default(0)
  calciumMg     Float   @default(0)
  ironMg        Float   @default(0)
  zincMg        Float   @default(0)
  magnesiumMg   Float   @default(0)
  cholesterolMg Float   @default(0)
  mealSlot      String
  loggedAt      DateTime @default(now())
  source        String   @default("tap")
  foodLog       FoodLog  @relation(fields: [foodLogId], references: [id], onDelete: Cascade)
  meal          Meal?    @relation(fields: [mealId], references: [id])
}

model DailyNutrition {
  id                 String   @id @default(cuid())
  userId             String
  date               String
  targetCalories     Float
  consumedCalories   Float    @default(0)
  targetProtein      Float
  consumedProtein    Float    @default(0)
  targetCarbs        Float
  consumedCarbs      Float    @default(0)
  targetFat          Float
  consumedFat        Float    @default(0)
  targetFiber        Float   @default(30)
  consumedFiber      Float   @default(0)
  targetCalciumMg    Float   @default(1000)
  consumedCalciumMg  Float   @default(0)
  targetIronMg       Float   @default(19)
  consumedIronMg     Float   @default(0)
  targetZincMg       Float   @default(17)
  consumedZincMg     Float   @default(0)
  targetMagnesiumMg  Float   @default(440)
  consumedMagnesiumMg Float  @default(0)
  targetCholesterolMg Float  @default(300)
  consumedCholesterolMg Float @default(0)
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, date])
}

model WaterLog {
  id              String   @id @default(cuid())
  userId          String
  logDate         String
  glassesConsumed Int      @default(0)
  targetGlasses   Int      @default(8)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, logDate])
}

model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  weightKg  Float
  logDate   String
  notes     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══ Recommendations & Plans ═══
model MealPlanDay {
  id                 String   @id @default(cuid())
  userId             String
  planDate           String
  targetCalories     Float
  targetProtein      Float
  targetCarbs        Float
  targetFat          Float
  targetFiber        Float   @default(30)
  targetCalciumMg    Float   @default(1000)
  targetIronMg       Float   @default(19)
  targetZincMg       Float   @default(17)
  targetMagnesiumMg  Float   @default(440)
  targetCholesterolMg Float  @default(300)
  status             String   @default("active")
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items              MealPlanItem[]
  @@unique([userId, planDate])
}

model MealPlanItem {
  id                String   @id @default(cuid())
  planDayId         String
  mealSlot          String
  mealId            String
  servingGms        Int      @default(0)
  recommendedCalories Float
  rankScore         Float?
  rankPosition      Int?
  createdAt         DateTime @default(now())
  planDay           MealPlanDay @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  meal              Meal       @relation(fields: [mealId], references: [id])
}

// ═══ System & AI ═══
model AiLog {
  id              String   @id @default(cuid())
  userId          String?
  modelType       String
  requestPayload  String?
  responsePayload String?
  latencyMs       Int?
  tokensUsed      Int?
  costUsd         Float?
  createdAt       DateTime @default(now())
}

// ═══ Unknown / New Food Submissions ═══
model UnknownFoodSubmission {
  id                    String   @id @default(cuid())
  userId                String
  imageFilePath         String?
  aiDetectedName        String
  confirmedName         String
  confirmedPortion      Int
  caloriesPer100g       Float
  proteinPer100g        Float
  carbsPer100g          Float
  fatPer100g            Float
  status                String   @default("pending")
  ingredientsJson       String?
  computedNutritionJson String?
  baseServingGms        Int?
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══ Session Store (persistent) ═══
model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt  DateTime
  createdAt DateTime @default(now())
}
